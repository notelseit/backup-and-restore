#!/usr/bin/env python3
"""Opt-in HTTPS health notification. Default is an offline preview."""
import argparse
import json
import os
import ssl
import sys
import urllib.parse
import urllib.request


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def payload(report):
    # Never forward paths, filenames, exception messages or arbitrary input fields.
    if not isinstance(report, dict) or report.get("status") not in ("ok", "critical"):
        raise ValueError("invalid health status")
    if report.get("kind") not in ("local", "encrypted"):
        raise ValueError("invalid backup kind")
    return {"service": "notelseit-backup", "status": report["status"],
            "kind": report["kind"]}


def send(event, endpoint, token):
    url = urllib.parse.urlsplit(endpoint)
    if (url.scheme != "https" or not url.hostname or url.username or url.password
            or url.query or url.fragment or any(c.isspace() for c in endpoint)):
        raise ValueError("endpoint must be HTTPS without credentials, query or fragment")
    if not token or any(ord(c) < 33 or ord(c) > 126 for c in token):
        raise ValueError("invalid bearer token")
    request = urllib.request.Request(endpoint, data=json.dumps(event).encode(),
        headers={"Content-Type": "application/json", "Authorization": "Bearer " + token},
        method="POST")
    # Ignore ambient proxies; preserve normal certificate and hostname verification.
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
    context.load_default_certs()
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}), NoRedirect(),
        urllib.request.HTTPSHandler(context=context))
    with opener.open(request, timeout=10) as response:
        if not 200 <= response.status < 300:
            raise ValueError("delivery rejected")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--send", action="store_true", help="explicitly enable delivery")
    args = parser.parse_args()
    try:
        raw = sys.stdin.buffer.read(65537)
        if len(raw) > 65536:
            raise ValueError("report too large")
        event = payload(json.loads(raw))
        if args.send:
            send(event, os.environ.get("NOTELSEIT_NOTIFY_URL", ""),
                 os.environ.get("NOTELSEIT_NOTIFY_TOKEN", ""))
            print("Notification delivered")
        else:
            print(json.dumps(event, sort_keys=True))
        return 0
    except Exception:
        # URLs, credentials and server error bodies must never enter logs.
        print("Notification failed: invalid report/configuration or delivery failure", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
